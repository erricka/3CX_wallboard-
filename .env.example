# Copy to .env and fill in. Never commit .env.

# 3CX XAPI (Admin Console > Integrations > API, with "XAPI Access Enabled")
THREECX_BASE_URL=https://maxbit.3cx.asia
THREECX_CLIENT_ID=dashboardamk
THREECX_CLIENT_SECRET=your-3cx-api-key

# Call center timezone: "today" / "yesterday" and daily rows use this zone
TIMEZONE=Asia/Phnom_Penh
# The agents listed on the wallboard are the members of these queues and ring groups.
# Queues, comma separated (e.g. 800,801). Empty = all queues, none = no queues.
WALLBOARD_QUEUES=none
# Ring groups, comma separated (e.g. 8001,8003). Empty = none.
WALLBOARD_RING_GROUPS=8001

# PostgreSQL password used by docker compose
POSTGRES_PASSWORD=change-me

# Optional tuning
# POLL_INTERVAL_SECONDS=3
# STATS_REFRESH_SECONDS=20
# SLOW_ANSWER_SECONDS=5
# BACKFILL_DAYS=31
# WALLBOARD_PORT=8080
